{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "WebFetch|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/scope-enforce.py",
            "timeout": 15,
            "statusMessage": "scope-guard: checking target against allowlist"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/session-context.py",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
